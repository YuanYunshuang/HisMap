{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "debugpy",
            "request": "launch",
            "name": "Training",
            "program": "${workspaceFolder}/smolsam2/train_one_gpu.py",
            "args": [
                "-d",
                "/koko/datasets/SMOL_syntra",
                "--data-info",
                "pairing_train_100shot_train_100shot_intercls.json",
                "-bs", "8", "-nw", "12", "--a", "4",
                "--debug",
                "--num-src", "3",
                "-t", "src3_data2.2",
                "--disable-runid"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "QT_QPA_PLATFORM": "offscreen"
            }
        },
        {
            "type": "debugpy",
            "request": "launch",
            "name": "Testing",
            "program": "${workspaceFolder}/smolsam2/test.py",
            "args": [
                "--num-src",
                "3"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "QT_QPA_PLATFORM": "offscreen"
            }
        }
    ]
  }